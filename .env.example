# Database connection for the rebuild (the Python package).
# This is the local Docker database from docker-compose.yml. It has no password.
DATABASE_URL="postgresql://telecompass@127.0.0.1:5433/telecompass"

# Needed only for commands that call a model (extract). Leave empty here; fill in .env.
# A variable already set in your environment wins over this file.
OPENAI_API_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
# The address of your Langfuse project's region, for example https://cloud.langfuse.com (EU)
# or https://us.cloud.langfuse.com (US).
LANGFUSE_BASE_URL=""

# Everything below belongs to the old app and goes away when the site is rebuilt.

# Ollama Configuration
OLLAMA_HOST="http://localhost:11434"
OLLAMA_EMBED_MODEL="nomic-embed-text:latest"
OLLAMA_CHAT_MODEL="mistral:7b-instruct-q4_K_M"

# Pinecone Configuration (Vector Database)
PINECONE_API_KEY="your-pinecone-api-key-here"
PINECONE_ENVIRONMENT="us-west-2"
PINECONE_INDEX_NAME="telecompass-policies"

# Security - Set to true only for admin ingestion
ALLOW_INGEST="false"
ALLOW_UPLOAD="false"

# NextAuth (for future authentication)
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
